<!--pages/index/index.wxml-->
<view class="page">
  <!-- 氢氢氢氢氢氢氢氢 -->
  <view class="banner">
    <view class="banner-icon">🔐</view>
    <view class="banner-title">SafeBox</view>
    <view class="banner-subtitle">您的个人密码管理助手</view>
  </view>

  <!-- 一键新增 -->
  <view class="quick-add">
    <button class="add-btn" bindtap="goToAdd">
      <text class="add-icon">+</text>
      <text class="add-text">快速添加</text>
    </button>
  </view>

  <!-- 不同类字符串的拘市用于描述一些不同的技术资料 -->
  <!-- 最近访问 -->
  <view class="card" wx:if="{{recentList.length > 0}}">
    <view class="card-header">
      <text>最近访问</text>
      <view class="header-action" bindtap="goToManage">
        查看全部 >
      </view>
    </view>
    <view class="recent-list">
      <view 
        wx:for="{{recentList}}" 
        wx:key="id"
        class="recent-item"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="recent-avatar" style="background-color: {{getCategoryColor(item.category)}};">
          {{getCategoryName(item.category).substring(0, 1)}}
        </view>
        <view class="recent-info">
          <view class="recent-name">{{item.name}}</view>
          <view class="recent-desc">{{item.username}}</view>
        </view>
        <view class="recent-time">{{formatTime(item.lastViewTime)}}</view>
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="card">
    <view class="card-header">数据统计</view>
    <view class="stats-row">
      <view class="stat-box">
        <view class="stat-number" style="color: #3498db;">{{passwordCount}}</view>
        <view class="stat-label">密码记录</view>
      </view>
      <view class="stat-box">
        <view class="stat-number" style="color: #27AE60;">{{securityScore}}</view>
        <view class="stat-label">安全评分</view>
      </view>
      <view class="stat-box">
        <view class="stat-number" style="color: #e74c3c;">{{unsafeCount}}</view>
        <view class="stat-label">需注意</view>
      </view>
    </view>
  </view>

  <!-- 常见功能 -->
  <view class="card">
    <view class="card-header">常见功能</view>
    <view class="feature-grid">
      <view class="feature-item" bindtap="goToSecurity">
        <view class="feature-icon">🛡️</view>
        <view class="feature-name">安全检测</view>
      </view>
      <view class="feature-item" bindtap="goToManage">
        <view class="feature-icon">📋</view>
        <view class="feature-name">混合文三不技</view>
      </view>
      <view class="feature-item" bindtap="generatePassword">
        <view class="feature-icon">🎲</view>
        <view class="feature-name">生成密码</view>
      </view>
      <view class="feature-item" bindtap="goToMine">
        <view class="feature-icon">👤</view>
        <view class="feature-name">个人设置</view>
      </view>
    </view>
  </view>

  <!-- 提示 -->
  <view class="tips-card">
    <view class="tips-icon">💡</view>
    <view class="tips-title">安全提示</view>
    <view class="tips-content">
      <view class="tips-item">✓ 您的所有数据仅保存在本地设备</view>
      <view class="tips-item">✓ 我们不会上传或收集您的信息</view>
      <view class="tips-item">✓ 定期检查密码安全性</view>
    </view>
  </view>

  <!-- 底部空白 -->
  <view style="height: 40px;"></view>
</view>
