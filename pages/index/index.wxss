/**pages/index/index.wxss**/

.page {
  padding-bottom: 60px;
}

.search-box {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #f5f5f5;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.search-icon {
  width: 18px;
  height: 18px;
  opacity: 0.5;
}

.search-box input {
  flex: 1;
  padding: 8px 12px;
  background-color: #ffffff;
  border-radius: 20px;
  font-size: 14px;
  height: 36px;
}

.close-icon {
  width: 18px;
  height: 18px;
  opacity: 0.5;
}

.search-results {
  padding-bottom: 60px;
}

.overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 16px;
}

.overview-item {
  text-align: center;
  padding: 12px 0;
  border-right: 1px solid #f0f0f0;
  border-bottom: 1px solid #f0f0f0;
}

.overview-item:nth-child(2n) {
  border-right: none;
}

.overview-item:nth-child(n+3) {
  border-bottom: none;
}

.overview-value {
  font-size: 24px;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4px;
}

.overview-label {
  font-size: 12px;
  color: #999999;
}

.overview-action {
  padding-top: 8px;
  border-top: 1px solid #f0f0f0;
}

.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12px;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px;
  border-radius: 8px;
  background-color: #f9f9f9;
  transition: all 0.2s;
}

.category-item:active {
  background-color: #f0f0f0;
  transform: scale(0.95);
}

.category-icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  color: #ffffff;
  margin-bottom: 8px;
}

.category-name {
  font-size: 13px;
  color: #333333;
  font-weight: 500;
  margin-bottom: 4px;
}

.category-count {
  font-size: 12px;
  color: #999999;
}

.arrow-icon {
  width: 16px;
  height: 16px;
  opacity: 0.5;
}
