<!--pages/mine/mine.wxml-->
<view class="page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-avatar">🔐</view>
    <view class="user-info">
      <view class="user-name">SafeBox</view>
      <view class="user-desc">个人密码管理小程序</view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="card">
    <view class="card-header">数据统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <view class="stat-value">{{totalPasswords}}</view>
        <view class="stat-label">密码总数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{totalImages}}</view>
        <view class="stat-label">图片总数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{lastBackupDays}}</view>
        <view class="stat-label">最后备份</view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="card">
    <view class="card-header">功能</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToSecurity">
        <view class="menu-icon">🛡️</view>
        <view class="menu-content">
          <view class="menu-title">安全检测</view>
          <view class="menu-desc">检测密码安全问题</view>
        </view>
        <image src="/images/icon/arrow-right.png" class="arrow-icon"></image>
      </view>
      <view class="menu-item" bindtap="exportData">
        <view class="menu-icon">����</view>
        <view class="menu-content">
          <view class="menu-title">导出数据</view>
          <view class="menu-desc">导出所有密码数据</view>
        </view>
        <image src="/images/icon/arrow-right.png" class="arrow-icon"></image>
      </view>
      <view class="menu-item" bindtap="importData">
        <view class="menu-icon">📥</view>
        <view class="menu-content">
          <view class="menu-title">导入数据</view>
          <view class="menu-desc">从文件导入密码数据</view>
        </view>
        <image src="/images/icon/arrow-right.png" class="arrow-icon"></image>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="card-header">关于</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="showAbout">
        <view class="menu-icon">ℹ️</view>
        <view class="menu-content">
          <view class="menu-title">关于 SafeBox</view>
          <view class="menu-desc">v1.0.0</view>
        </view>
        <image src="/images/icon/arrow-right.png" class="arrow-icon"></image>
      </view>
      <view class="menu-item" bindtap="showPrivacy">
        <view class="menu-icon">🔒</view>
        <view class="menu-content">
          <view class="menu-title">隐私声明</view>
          <view class="menu-desc">了解数据处理方式</view>
        </view>
        <image src="/images/icon/arrow-right.png" class="arrow-icon"></image>
      </view>
    </view>
  </view>

  <!-- 危险操作 -->
  <view class="card danger-zone">
    <view class="card-header" style="color: #e74c3c;">危险操作</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="clearAllData">
        <view class="menu-icon" style="color: #e74c3c;">🗑️</view>
        <view class="menu-content">
          <view class="menu-title" style="color: #e74c3c;">清空所有数据</view>
          <view class="menu-desc">删除所有密码记录（不可恢复）</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部版本信息 -->
  <view class="footer">
    <view class="footer-text">SafeBox v1.0.0</view>
    <view class="footer-text" style="font-size: 12px; color: #999; margin-top: 8px;">
      © 2026 xjyon. All rights reserved.
    </view>
  </view>
</view>
